{
  "common_disallowed": [
    "PowerShell",
    "Bash(git push:*)",
    "Bash(*--no-verify*)",
    "Bash(gh pr merge:*)",
    "Bash(gh release:*)",
    "Bash(docker push:*)",
    "Bash(docker login:*)",
    "Bash(kubectl:*)",
    "Bash(helm:*)",
    "Bash(terraform apply:*)",
    "Bash(terraform destroy:*)",
    "Bash(*upload_images*)",
    "Bash(*publish-complete-release*)",
    "Bash(mkdocs build:*)"
  ],
  "remote_disallowed": [
    "Bash(ssh:*)",
    "Bash(scp:*)",
    "Bash(sftp:*)",
    "Bash(rsync:*)"
  ],
  "brief_scan_fields": [
    "objective",
    "context",
    "criteria",
    "notes",
    "message"
  ],
  "brief_forbidden": [
    {
      "pattern": "\\bprod(uction|uccion|ucción)?\\b",
      "why": "toca produccion (nivel 3: lo confirma el usuario en el momento)"
    },
    {
      "pattern": "\\bgit\\s+push\\b",
      "why": "push al remoto (nivel 3)"
    },
    {
      "pattern": "\\bupload[_ -]?images\\b|\\bpublicar\\s+imagen",
      "why": "subida de imagenes (nivel 3)"
    },
    {
      "pattern": "\\bdeploy\\w*\\b|\\bdespleg\\w*|\\bdesplieg\\w*",
      "why": "despliegue sin destino autorizado",
      "unless_destinations": true
    }
  ],
  "roles": {
    "glen": {
      "model": "sonnet",
      "permission_mode": "auto",
      "inactivity_min": 15,
      "writes_code": false,
      "disallowed": [
        "NotebookEdit"
      ],
      "write_paths": {
        "investigate": [],
        "init": [
          "CLAUDE.md",
          "TECHNICAL_DOCUMENTATION.md",
          "CLAUDE.local.md"
        ]
      }
    },
    "baz": {
      "model": "opus",
      "permission_mode": "auto",
      "inactivity_min": 30,
      "writes_code": true,
      "disallowed": [],
      "write_paths": {
        "plan": [
          "outputs/**",
          ".project-state/**"
        ],
        "execute": "*"
      },
      "requires_flow": true,
      "approval_phases": [
        "execute"
      ]
    },
    "dembe": {
      "model": "opus",
      "permission_mode": "auto",
      "inactivity_min": 20,
      "writes_code": false,
      "disallowed": [
        "NotebookEdit"
      ],
      "write_paths": {
        "verify": [
          "@lecciones"
        ],
        "retro": [
          "@lecciones"
        ]
      }
    },
    "kaplan": {
      "model": "sonnet",
      "permission_mode": "auto",
      "inactivity_min": 10,
      "writes_code": false,
      "disallowed": [
        "Bash(git worktree remove:*)",
        "Bash(git worktree prune:*)",
        "Bash(git worktree move:*)",
        "Bash(git reset --hard:*)",
        "Bash(git clean:*)",
        "Bash(git branch -D:*)"
      ],
      "write_paths": {
        "cleanup": []
      }
    },
    "zeng": {
      "model": "haiku",
      "permission_mode": "auto",
      "inactivity_min": 5,
      "writes_code": false,
      "reads_only_costs": true,
      "disallowed": [
        "Edit",
        "Write",
        "NotebookEdit"
      ],
      "allowed": [
        "Bash(bash ~/.claude/red/scripts/red-cost.sh:*)"
      ],
      "write_paths": {
        "report": []
      }
    }
  },
  "flows": {
    "flow-bugfix": {
      "command": "/flow-bugfix",
      "gate": "veredicto de impacto + causa raiz identificada",
      "required": {
        "plan": [
          "impact-prevalidator",
          "code-explorer"
        ],
        "execute": [
          "tdd-guide",
          "code-reviewer",
          "20-linting-validator",
          "19-smoke-test"
        ]
      }
    },
    "flow-update": {
      "command": "/flow-update",
      "gate": "veredicto de impacto + plan con slices + critica de plan-critic",
      "required": {
        "plan": [
          "impact-prevalidator",
          "code-explorer",
          "code-architect",
          "planner",
          "plan-critic"
        ],
        "execute": [
          "tdd-guide",
          "code-reviewer",
          "20-linting-validator",
          "19-smoke-test"
        ]
      }
    },
    "flow-new-project": {
      "command": "/flow-new-project",
      "gate": "paquete de decisiones: impacto, dominio, arquitectura, sprint plan y critica de plan-critic",
      "required": {
        "plan": [
          "impact-prevalidator",
          "01-product-discovery",
          "02-domain-modeling",
          "03-context-mapping",
          "04-architecture-decision",
          "05-service-design",
          "06-epic-generation",
          "07-user-story-generation",
          "08-tech-lead-delivery",
          "09-sprint-orchestrator",
          "plan-critic"
        ],
        "execute": [
          "12-infrastructure-deployment",
          "13-backend-test",
          "14-backend-development",
          "17-integration-test",
          "18-e2e-test",
          "19-smoke-test",
          "20-linting-validator",
          "21-security-review"
        ]
      }
    }
  }
}
